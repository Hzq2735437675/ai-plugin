{
  "$schema": "./package-manifest.schema.json",
  "schemaVersion": 1,
  "name": "ai-baseline-kit",
  "version": "0.6.0",
  "type": "embedded-ai-capability-package",
  "description": "AI 前端模块装配系统：可完整植入目标项目，支持需求确认、结构化生成、验收测试、同栈模块迁移组合、AST 边界检查和旧项目增量治理闭环。",
  "entrypoints": {
    "primary": "AGENTS.md",
    "documentation": "README.md",
    "installation": "INSTALL.md",
    "skills": "skills/README.md",
    "validation": "scripts/baseline-check.mjs",
    "stackProfiles": "docs/stack-profiles.yml",
    "doctor": "scripts/project-doctor.mjs",
    "bootstrap": "scripts/project-bootstrap.mjs",
    "projectValidation": "scripts/project-validate.mjs",
    "toolSelfCheck": "scripts/project-tools-check.mjs",
    "reactTemplate": "templates/react18-antd-tailwind-ts/README.md",
    "vueTemplate": "templates/vue3-vite-ts/README.md",
    "contractSelfCheck": "scripts/baseline-contract-check.mjs",
    "requirementCompiler": "scripts/requirement-compile.mjs",
    "featurePlanner": "scripts/feature-plan.mjs",
    "featureGenerator": "scripts/feature-generate.mjs",
    "moduleCreator": "scripts/module-create.mjs",
    "featureSpecSchema": "docs/feature-spec.schema.json",
    "changePlanSchema": "docs/change-plan.schema.json",
    "moduleMetadataSchema": "docs/module-meta.schema.json",
    "designSystem": "docs/design-system.yml",
    "templateBuildCheck": "scripts/template-build-check.mjs",
    "moduleExporter": "scripts/module-export.mjs",
    "moduleImporter": "scripts/module-import.mjs",
    "moduleCompatibilityChecker": "scripts/module-compatibility-check.mjs",
    "projectComposer": "scripts/project-compose.mjs",
    "moduleBundleSchema": "docs/module-bundle.schema.json",
    "projectCompositionSchema": "docs/project-composition.schema.json",
    "astBoundaryChecker": "scripts/ast-boundary-check.mjs"
  },
  "installation": {
    "guide": "INSTALL.md",
    "modes": [
      "embedded-directory"
    ],
    "copyItems": [
      "ai-baseline-kit/"
    ]
  },
  "distribution": {
    "mode": "embedded-directory",
    "preserveDirectoryName": true,
    "targetDirectory": "<project-root>/ai-baseline-kit/",
    "companionFiles": [],
    "sameStackRequired": false
  },
  "dependencies": {
    "packages": [],
    "runtime": [],
    "external": []
  }
}
