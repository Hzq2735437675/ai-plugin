{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-baseline.local/execution-policy.schema.json",
  "title": "AI Baseline Controlled Execution Policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rollbackOnFailure": { "type": "boolean", "default": true },
    "requireValidation": { "type": "boolean", "default": true },
    "maxRepairAttempts": { "type": "integer", "minimum": 0, "default": 0 },
    "allowBaselineMaintenance": { "type": "boolean", "default": false },
    "additionalAllowedRoots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
  }
}
