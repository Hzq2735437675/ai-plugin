{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-baseline.local/change-plan.schema.json",
  "title": "AI Baseline Frontend Change Plan",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "featureSpec", "decision", "ownership", "assembly", "files", "requiredQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "frontend-change-plan" },
    "status": { "enum": ["ready", "needs-confirmation"] },
    "decision": { "type": "object", "required": ["type", "reason"] },
    "ownership": { "type": "object", "required": ["layer", "module", "moduleRoot"] },
    "assembly": { "type": "object" },
    "dependencies": { "type": "object" },
    "files": { "type": "object", "required": ["create", "modify", "allowedRoots", "forbidden"] },
    "moduleContract": { "type": "object" },
    "requiredQuestions": { "type": "array" }
  }
}
