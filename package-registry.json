{
  "$schema": "./package-registry.schema.json",
  "schemaVersion": 1,
  "repository": {
    "name": "ai-plugin",
    "packageLayout": {
      "currentPackageCompatibilityRoot": "ai-baseline-kit/",
      "futurePackageRoot": "packages/<package-name>/",
      "registry": "package-registry.json"
    },
    "packageContract": "package-manifest.schema.json"
  },
  "packages": [
    {
      "name": "ai-baseline-kit",
